# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Virtual environments
.venv/
venv/
env/

# Environment variables / secrets
.env
.env.*

# Databases
*.db
*.sqlite3

# Model artifacts — pkl files ARE tracked (required for cloud deploys)
!model/artifacts/*.pkl

# Generated data — tracked so cloud deploys can serve it without retraining
# (fully deterministic: seed 42, regenerate via data/generator.py)
# data/chargebacks_synthetic.csv

# SQLite DB tracked so fresh clones/deploys boot with schema + seed data
!data/chargebacks.db

# Logs
logs/
*.log

# Test / coverage
.pytest_cache/
.coverage
htmlcov/

# Notebooks
.ipynb_checkpoints/

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/

# Streamlit
.streamlit/secrets.toml
